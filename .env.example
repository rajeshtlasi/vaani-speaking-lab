# Public client values, safe to expose only with the supplied RLS policies applied.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-only Netlify environment variables. Never prefix these with VITE_.
SUPABASE_URL=
SUPABASE_ANON_KEY=
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
# Local seeding only. Do not put the service-role key in browser code.
SUPABASE_SERVICE_ROLE_KEY=
